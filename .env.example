PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-long-random-string

# Microsoft Entra ID app registration (Azure portal > Entra ID > App registrations)
MS_TENANT=common            # or your tenant ID
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=change-me

# Value you pass as clientState when creating a Graph subscription
GRAPH_CLIENT_STATE=change-me
